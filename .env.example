# Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=info

# Which ASR backend to load. "mock" is deterministic and needs no credentials,
# so the gateway runs end to end with nothing configured.
GATEWAY_BACKEND=mock

# Audio contract enforced at session start.
GATEWAY_SAMPLE_RATE=16000
GATEWAY_ENCODING=linear16
GATEWAY_MAX_CHANNELS=1

# Backpressure. When the inbound queue is full the oldest chunk is dropped:
# for real-time audio, stale audio is worth less than fresh audio.
GATEWAY_QUEUE_SIZE=64

# Session limits.
GATEWAY_MAX_SESSION_SECONDS=300
GATEWAY_IDLE_TIMEOUT_SECONDS=30
GATEWAY_MAX_CHUNK_BYTES=65536
